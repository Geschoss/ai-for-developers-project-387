{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permission": {
    "edit": "deny",
    "webfetch": "deny",
    "external_directory": {
      "*": "deny"
    },
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "gh pr view*": "allow",
      "gh pr diff*": "allow",
      "gh pr checks*": "allow",
      "gh run view*": "allow",
      "gh run list*": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "gh api repos/Geschoss/ai-for-developers-project-387/*": "allow"
    }
  }
}
